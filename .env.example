# Root (combined) project — Frontend ENV (copy to .env)
#
# PHP backend URL (Wasmer). Leave empty to use localStorage only.
# No trailing slash. The API lives under {VITE_API_URL}/api/*.
VITE_API_URL=
# VITE_API_URL=https://parimatch-backend.wasmer.app

# (VITE_BASE_PATH is set to /site inside vite.config.js for this project.)

# Root (combined) project — Frontend ENV (copy to .env)
#
# Data storage endpoint = Google Apps Script web app (/exec URL).
# Leave empty to use localStorage only (app fully works, data stays in browser).
VITE_API_URL=
# VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# (VITE_BASE_PATH is set to /site inside vite.config.js for this project.)

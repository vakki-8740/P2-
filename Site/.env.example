# Site — Frontend ENV (copy to Site/.env)
#
# Data storage endpoint = Google Apps Script web app (/exec URL).
# Leave empty to run in localStorage-only mode.
# No trailing slash.
VITE_API_URL=
# VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional: mount prefix. Leave empty for the Site deployment (domain root).
# The combined root project sets /site automatically in vite.config.js.
# VITE_BASE_PATH=

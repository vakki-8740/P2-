# Site — Frontend ENV (copy to Site/.env)
#
# PHP backend URL (Wasmer). Leave empty to run in localStorage-only mode.
# No trailing slash.
VITE_API_URL=
# VITE_API_URL=https://parimatch-backend-vakki-8740.wasmer.app

# Optional: mount prefix. Leave empty for the Site deployment (domain root).
# The combined root project sets /site automatically in vite.config.js.
# VITE_BASE_PATH=

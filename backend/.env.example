# Backend ENV — copy to backend/.env for local runs.
# On Wasmer set these with `wasmer secret create` or in app.yaml -> env.
# (The PHP runtime used here does not read .env files automatically — export
#  the variables in your shell, e.g. `export DB_HOST=... && npm run serve`.)

# --- Database -------------------------------------------------
# Leave empty to use the SQLite fallback (backend/data/app.db locally,
# /tmp/parimatch_app.db on Wasmer).
DB_HOST=
DB_PORT=3306
DB_NAME=parimatch_support
DB_USER=root
DB_PASS=
# DB_PATH=/absolute/path/to/app.db

# --- Uploads --------------------------------------------------
# Default: backend/data/uploads (created automatically, /tmp on Wasmer)
# UPLOAD_DIR=/absolute/path/to/uploads
MAX_UPLOAD_MB=100
MAX_REQUEST_MB=300

# --- Security -------------------------------------------------
# Comma separated browser origins, or * for any (default).
# CORS_ORIGINS=https://parimatch-senter-center.vercel.app,https://parimatch-blog.vercel.app,http://localhost:5173
# Enables ?scope=all reads for the future admin panel. Keep empty to disable.
# ADMIN_API_TOKEN=change-me-long-random-token
# 32+ random chars. If empty, a key is generated once and stored in `settings`.
# APP_KEY=

# --- Debug ----------------------------------------------------
# APP_DEBUG=false

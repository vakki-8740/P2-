# Backend ENV — copy to .env and fill
# For local: leave DB_* empty to use SQLite (auto-created at /tmp/parimatch_app.db)
# For production Wasmer: set MySQL and create secrets via `wasmer secret create`

DB_HOST=
DB_PORT=3306
DB_NAME=parimatch_support
DB_USER=root
DB_PASS=

# Frontend API URL (Vite)
VITE_API_URL=http://localhost:8080
# On Wasmer after deploy: https://parimatch-backend-vakki-8740.wasmer.app
# Set in Site/.env and Blog/.env and Root .env as VITE_API_URL

# Optional
APP_DEBUG=false
